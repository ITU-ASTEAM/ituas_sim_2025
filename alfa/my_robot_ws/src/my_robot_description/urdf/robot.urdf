<robot name="boat" version="1.0">

  <!-- Base link -->
  <link name="base_link">
  <inertial>
    <mass value="5.0"/>
    <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
  </inertial>

  <collision name="lidar_collision">
    <origin rpy="0 1.5708 0" xyz="0.05862 -0.0027 -0.01667"/>
    <geometry>
      <cylinder radius="0.19161" length="0.5918"/>
    </geometry>
  </collision>

  <visual name="lidar">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <geometry>
      <mesh filename="/home/gauss/Desktop/my_robot_ws/src/my_robot_description/models/boat/meshes/stl/denemeas.003.stl" scale="1 1 1"/>
    </geometry>
  </visual>
</link>

  <!-- Left motor -->
  <link name="leftmotor_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision name="leftmotor_collision">
      <origin rpy="0 0 0" xyz="0.01284 -0.00081 0.00606"/>
      <geometry>
        <cylinder radius="0.01497" length="0.04150"/>
      </geometry>
    </collision>
    <visual name="leftmotor">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="/home/gauss/Desktop/my_robot_ws/src/my_robot_description/models/boat/meshes/stl/denemeas.001.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Right motor -->
  <link name="rightmotor_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision name="rightmotor_collision">
      <origin rpy="0 0 0" xyz="0.01116 -0.00028 0.00625"/>
      <geometry>
        <cylinder radius="0.01496" length="0.04150"/>
      </geometry>
    </collision>
    <visual name="rightmotor">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="/home/gauss/Desktop/my_robot_ws/src/my_robot_description/models/boat/meshes/stl/denemeas.002.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Joints -->
  <joint name="leftmotor_link_joint" type="continuous">
  <parent link="base_link"/>
  <child link="leftmotor_link"/>
  <origin rpy="0 0 0" xyz="-0.47567 0.24862 -0.39168"/>
  <axis xyz="0 0 1"/>
</joint>

<joint name="rightmotor_link_joint" type="continuous">
  <parent link="base_link"/>
  <child link="rightmotor_link"/>
  <origin rpy="0 0 0" xyz="-0.47445 -0.27153 -0.39207"/>
  <axis xyz="0 0 1"/>
</joint>

</robot>
