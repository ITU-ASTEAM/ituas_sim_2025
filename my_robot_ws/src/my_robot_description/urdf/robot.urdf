<?xml version="1.0"?>
<robot name="boat">

  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <collision name="base_collision">
      <origin rpy="0 1.5708 0" xyz="0.05862 -0.0027 -0.01667"/>
      <geometry>
        <cylinder radius="0.19161" length="0.5918"/>
      </geometry>
    </collision>

    <visual name="base_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/models/boat/meshes/stl/denemeas.003.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <link name="leftmotor_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/models/boat/meshes/stl/denemeas.001.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="leftmotor_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leftmotor_link"/>
    <origin rpy="0 0 0" xyz="-0.47567 0.24862 -0.39168"/>
  </joint>

  <link name="rightmotor_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/models/boat/meshes/stl/denemeas.002.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="rightmotor_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rightmotor_link"/>
    <origin rpy="0 0 0" xyz="-0.47445 -0.27153 -0.39207"/>
  </joint>

  <link name="gpu_lidar">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gpu_lidar"/>
    <origin xyz="0.5 0 0.6" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.5 0 0.4" rpy="0 0 0"/>
  </joint>

</robot>
