<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="boat">

    <pose>0 0 0.15 0 0 0</pose>

    <!-- ===== BASE LINK ===== -->
    <link name="base_link">

      <velocity_decay>
        <linear>40.0</linear>
        <angular>120.0</angular>
      </velocity_decay>

      <inertial>
        <mass>36.77</mass>
        <pose>0.013 0 -0.05 0 0 0</pose>
        <inertia>
          <ixx>20</ixx>
          <iyy>18</iyy>
          <izz>20</izz>
        </inertia>
      </inertial>

      <!-- BUOYANCY COLLISION -->
      <collision name="hull_buoyancy">
        <pose>-0.121 0 -0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>1.151 0.797 0.15</size>
          </box>
        </geometry>
      </collision>

      <!-- PHYSICS COLLISION -->
      <collision name="hull_physics">
        <geometry>
          <mesh>
            <uri>meshes/stl/denemeas.003.stl</uri>
          </mesh>
        </geometry>
      </collision>
      

      <!-- VISUAL -->
      <visual name="hull_visual">
        <geometry>
          <mesh>
            <uri>meshes/stl/denemeas.003.stl</uri>
          </mesh>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.6 1</ambient>
          <diffuse>0.1 0.2 0.8 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

    </link>

    <!-- ===== LEFT MOTOR ===== -->
    <link name="left_motor">
      <pose relative_to="base_link">-0.48 0.10 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="left_motor_buoyancy">
        <geometry>
          <sphere>
            <radius>0.09</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <!-- ===== RIGHT MOTOR ===== -->
    <link name="right_motor">
      <pose relative_to="base_link">-0.48 -0.10 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="right_motor_buoyancy">
        <geometry>
          <sphere>
            <radius>0.09</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <!-- ===== JOINTS ===== -->
    <joint name="left_motor_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_motor</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>5.0</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_motor_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_motor</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>5.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ===== THRUSTERS ===== -->
    <plugin filename="libgz-sim-thruster-system.so"
            name="gz::sim::systems::Thruster">
      <joint_name>left_motor_joint</joint_name>
      <thrust_coefficient>0.2</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.18</propeller_diameter>
    </plugin>

    <plugin filename="libgz-sim-thruster-system.so"
            name="gz::sim::systems::Thruster">
      <joint_name>right_motor_joint</joint_name>
      <thrust_coefficient>0.2</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.18</propeller_diameter>
    </plugin>

    <!-- ===== BUOYANCY ===== -->
    <plugin filename="libgz-sim-buoyancy-engine-system.so"
            name="gz::sim::systems::BuoyancyEngine">
      <link_name>base_link</link_name>
      <default_volume>0.03807</default_volume>
    </plugin>

    <plugin filename="libgz-sim-buoyancy-engine-system.so"
            name="gz::sim::systems::BuoyancyEngine">
      <link_name>left_motor</link_name>
      <default_volume>0.0003</default_volume>
    </plugin>

    <plugin filename="libgz-sim-buoyancy-engine-system.so"
            name="gz::sim::systems::BuoyancyEngine">
      <link_name>right_motor</link_name>
      <default_volume>0.0003</default_volume>
    </plugin>

  </model>

</sdf>